# ViraTrend — variáveis de ambiente. Copie cada bloco para o arquivo indicado.
# Nunca commite valores reais. Em produção, configure no painel (Vercel / Hostinger).

# ─── apps/api/.env ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Hostinger: o app Node e o MySQL ficam no mesmo servidor → host 127.0.0.1 (não o srvNNNN.hstgr.io)
DATABASE_URL=mysql://USUARIO:SENHA@127.0.0.1:3306/viratrend
# Mantenha baixo em hospedagem compartilhada (limite de conexões por usuário MySQL)
DATABASE_POOL_SIZE=5
# Origens do site com permissão de CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000
SESSION_TTL_HOURS=12
PUBLIC_API_URL=http://localhost:4000
# URL pública da API, usada pelo painel /admin no navegador (precisa estar em CORS_ORIGINS da API)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Hosts de imagem otimizados pelo next/image (o storage próprio), separados por vírgula
IMAGE_HOSTS=
# Perfis e contato: vazios = o site mostra "em breve" em vez de link inventado
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
# Hostinger: 1 (um proxy na frente do Node). Local: 0
TRUST_PROXY=0

# ─── apps/web/.env.local ───────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Lido só no servidor do Next (Server Components). Não use NEXT_PUBLIC_ para a API.
API_URL=http://localhost:4000
# Hosts de imagem otimizados pelo next/image (o storage próprio), separados por vírgula
IMAGE_HOSTS=
# Perfis e contato: vazios = o site mostra "em breve" em vez de link inventado
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
